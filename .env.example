# GA4 measurement ID for THIS site's own property (G-XXXXXXXXXX). Separate
# property from the villa — do NOT reuse G-J2V0ZJC643. Empty = GA off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (optional). Use the value from the
# GSC "HTML tag" method: <meta name="google-site-verification" content="THIS">.
# Or skip this and verify via the Google Analytics method once GA4 is live.
GOOGLE_SITE_VERIFICATION=

# Public site URL (used for canonical, sitemap, OG). Use www to match the
# primary domain (apex redirects to www, same convention as the villa).
NEXT_PUBLIC_SITE_URL=https://www.bootleggerslanding.com

# Availability iCal feeds — SERVER-ONLY (never prefix with NEXT_PUBLIC_; these
# carry secret tokens and the repo is public). Each unit's Airbnb calendar
# "Export calendar" .ics URL. The Villa uses its public Google Calendar .ics.
ICAL_URBAN_GEM_AIRBNB=
ICAL_DENALI_AIRBNB=
ICAL_WATERFRONT_AIRBNB=
ICAL_VILLA_GCAL=
